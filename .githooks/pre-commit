#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Hard block local gate bypasses.
# Only worklog-specific override flags are allowed.
disallowed_overrides=(
  "ALLOW_MAIN_COMMIT"
  "ALLOW_REFACTORED_SIDE_CARS"
  "ALLOW_BYPASS_CHECKS"
  "SKIP_SECRET_SCAN"
  "SKIP_DB_MIGRATION_CHECK"
  "SKIP_MAINTAINABILITY_CHECK"
  "SKIP_FEATURE_CHECK"
  "SKIP_REGRESSION_CHECK"
  "SKIP_REGRESSION_TESTS"
  "SKIP_EXPORT_CHECK"
)
for var_name in "${disallowed_overrides[@]}"; do
  if [[ -n "${!var_name:-}" ]]; then
    echo "[pre-commit] $var_name is not allowed." >&2
    echo "[pre-commit] Resolve failing checks instead of bypassing them." >&2
    echo "[pre-commit] Only worklog overrides are permitted: ALLOW_WORKLOG_TICKETS_EDIT, ALLOW_WORKLOG_REWRITE." >&2
    exit 1
  fi
done

# Block direct commits on main to enforce PR-based review flow.
current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$current_branch" == "main" ]]; then
  echo "[pre-commit] Direct commits on 'main' are blocked." >&2
  echo "[pre-commit] Create a short-lived branch and commit there for PR review:" >&2
  echo "[pre-commit]   ./scripts/start_wip_branch.sh <ticket-or-scope>" >&2
  echo "[pre-commit]   # or: git switch -c codex/wip-<ticket-or-scope>" >&2
  exit 1
fi

# Fail fast on unintended WORKLOG_TICKETS edits (even if unstaged).
# Explicit curation can override with ALLOW_WORKLOG_TICKETS_EDIT=1.
if [[ "${ALLOW_WORKLOG_TICKETS_EDIT:-}" != "1" ]]; then
  if git diff --name-only | grep -q '^docs/WORKLOG_TICKETS.md$'; then
    echo "[pre-commit] docs/WORKLOG_TICKETS.md has unstaged local edits." >&2
    echo "[pre-commit] Use docs/WORKLOG_ADDENDUM_*.md for active updates." >&2
    echo "[pre-commit] If this is intentional curation, rerun with ALLOW_WORKLOG_TICKETS_EDIT=1." >&2
    exit 1
  fi
fi

# 1. Agent gate: worklog enforcement + mandatory local pre-commit review trace
./scripts/agent_gate.sh --staged

# 2. Secret scan: block commits that include leaked credentials
./scripts/secret_scan.sh --staged

# 3. DB migration guard: block model-layer DB changes without Alembic migration
./scripts/db_migration_guard.sh --staged

# 4. Static maintainability guard: catch oversized/high-complexity source files
# Checks staged blobs directly, including newly added files.
./scripts/maintainability_guard.sh --staged

# 5. Feature regression check: detect removed functionality in large refactors
# Triggered when >10% LOC changed in existing files
./scripts/feature_regression_check.sh --staged

# 6. Regression check: tests + export comparison + TypeScript
./scripts/regression_check.sh --staged

# 7. Auto-push/PR threshold arming:
# If staged file count crosses threshold, arm post-commit automation.
# Disable with AUTO_PR_THRESHOLD_ENABLED=0
./scripts/auto_pr_threshold.sh arm
