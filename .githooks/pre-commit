#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Workflow: all local work happens on main.
# Agents MUST NOT create branches manually.
# Only ./scripts/start_wip_branch.sh may create a codex/wip-* branch.
# That script carries local-main commits to the WIP branch, resets main to
# origin/main, pushes the branch, and opens the PR.
current_branch="$(git rev-parse --abbrev-ref HEAD)"
git_dir="$(git rev-parse --git-dir)"
marker_file="$git_dir/WIP_BRANCH_AUTHORIZED"

# If committing on a non-main branch, it must have been created via start_wip_branch.sh
if [[ "$current_branch" != "main" ]]; then
  if [[ ! -f "$marker_file" ]] || ! grep -qxF "$current_branch" "$marker_file"; then
    echo "[pre-commit] ❌ Branch '$current_branch' was not created via start_wip_branch.sh" >&2
    echo "[pre-commit]    Agents must not create branches manually." >&2
    echo "[pre-commit]    To start a PR workflow: ./scripts/start_wip_branch.sh <scope>" >&2
    exit 1
  fi
fi

# Fail fast on unintended WORKLOG_TICKETS edits (even if unstaged).
# Explicit curation can override with ALLOW_WORKLOG_TICKETS_EDIT=1.
if [[ "${ALLOW_WORKLOG_TICKETS_EDIT:-}" != "1" ]]; then
  if git diff --name-only | grep -q '^docs/WORKLOG_TICKETS.md$'; then
    echo "[pre-commit] docs/WORKLOG_TICKETS.md has unstaged local edits." >&2
    echo "[pre-commit] Use docs/WORKLOG_ADDENDUM_*.md for active updates." >&2
    echo "[pre-commit] If this is intentional curation, rerun with ALLOW_WORKLOG_TICKETS_EDIT=1." >&2
    exit 1
  fi
fi

# 1. Agent gate: worklog enforcement + mandatory local pre-commit review trace
./scripts/agent_gate.sh --staged

# 2. Secret scan: block commits that include leaked credentials
# NOTE: SKIP_SECRET_SCAN is disabled by repo policy — secret_scan.sh enforces this directly.
./scripts/secret_scan.sh --staged

# 3. DB migration guard: block model-layer DB changes without Alembic migration
# Skip with SKIP_DB_MIGRATION_CHECK=1 or --no-verify
if [[ "${SKIP_DB_MIGRATION_CHECK:-}" != "1" ]]; then
  ./scripts/db_migration_guard.sh --staged
else
  echo "[pre-commit] Skipping DB migration check (SKIP_DB_MIGRATION_CHECK=1)"
fi

# 4. Static maintainability guard: catch oversized/high-complexity source files
# Checks staged blobs directly, including newly added files.
# Skip with SKIP_MAINTAINABILITY_CHECK=1 or --no-verify
if [[ "${SKIP_MAINTAINABILITY_CHECK:-}" != "1" ]]; then
  ./scripts/maintainability_guard.sh --staged
else
  echo "[pre-commit] Skipping maintainability guard (SKIP_MAINTAINABILITY_CHECK=1)"
fi

# 5. Feature regression check: detect removed functionality in large refactors
# Triggered when >10% LOC changed in existing files
# Skip with SKIP_FEATURE_CHECK=1 or --no-verify
if [[ "${SKIP_FEATURE_CHECK:-}" != "1" ]]; then
  ./scripts/feature_regression_check.sh --staged
else
  echo "[pre-commit] Skipping feature regression check (SKIP_FEATURE_CHECK=1)"
fi

# 6. Regression check: tests + export comparison + TypeScript
# Skip with SKIP_REGRESSION_CHECK=1 or --no-verify
if [[ "${SKIP_REGRESSION_CHECK:-}" != "1" ]]; then
  ./scripts/regression_check.sh --staged
else
  echo "[pre-commit] Skipping regression check (SKIP_REGRESSION_CHECK=1)"
fi

# 7. Auto-push/PR threshold arming:
# If staged file count crosses threshold, arm post-commit automation.
# Disable with AUTO_PR_THRESHOLD_ENABLED=0
./scripts/auto_pr_threshold.sh arm
