#!/bin/bash
#
# Pre-push hook to run deployment checks
# This prevents pushing code that would break production
#

set -e

echo "🔍 Running pre-push deployment checks..."
echo ""

# Check if we're in the backend directory context
cd "$(git rev-parse --show-toplevel)"

disallowed_overrides=(
    "ALLOW_REFACTORED_SIDE_CARS"
    "ALLOW_BYPASS_CHECKS"
    "SKIP_SECRET_SCAN"
    "SKIP_DB_MIGRATION_CHECK"
    "SKIP_MAINTAINABILITY_CHECK"
    "SKIP_FEATURE_CHECK"
    "SKIP_REGRESSION_CHECK"
    "SKIP_REGRESSION_TESTS"
    "SKIP_EXPORT_CHECK"
)
for var_name in "${disallowed_overrides[@]}"; do
    if [[ -n "${!var_name:-}" ]]; then
        echo "❌ pre-push blocked: $var_name is not allowed."
        echo "Resolve checks instead of bypassing them."
        echo "Only worklog overrides are permitted: ALLOW_WORKLOG_TICKETS_EDIT, ALLOW_WORKLOG_REWRITE."
        exit 1
    fi
done

# Scan commits being pushed for secrets so branch-history leaks are caught
# locally before GitHub push protection rejects the ref update.
had_refs=false
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    had_refs=true

    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi

    # Block direct pushes to origin/main. All code reaches main via PR only.
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "❌ Direct push to origin/main is blocked." >&2
        echo "   Use ./scripts/start_wip_branch.sh <scope> to create a PR branch." >&2
        exit 1
    fi

    # Block pushing a new branch that was not created via start_wip_branch.sh
    git_dir="$(git rev-parse --git-dir)"
    marker_file="$git_dir/WIP_BRANCH_AUTHORIZED"
    branch_name="${remote_ref#refs/heads/}"
    if [[ "$remote_ref" == refs/heads/* && "$remote_sha" =~ ^0+$ && "$branch_name" != "main" ]]; then
        if [[ ! -f "$marker_file" ]] || ! grep -qxF "$branch_name" "$marker_file"; then
            echo "❌ Push of new branch '$branch_name' is blocked." >&2
            echo "   Agents must not create branches manually." >&2
            echo "   Use: ./scripts/start_wip_branch.sh <scope>" >&2
            exit 1
        fi
    fi

    if [[ -n "${remote_sha:-}" && ! "$remote_sha" =~ ^0+$ ]]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
            echo ""
            echo "❌ Non-fast-forward push detected for $local_ref -> $remote_ref."
            echo "Force pushes are blocked. Rebase/merge and push a fast-forward update."
            exit 1
        fi
        range="${remote_sha}..${local_sha}"
    else
        range="${local_sha} --not --remotes"
    fi

    # Enforce agent-gate on every pushed commit so --no-verify local commits
    # cannot bypass required worklog/ticket policy checks.
    while read -r commit_sha; do
        [[ -z "${commit_sha:-}" ]] && continue
        ./scripts/agent_gate.sh --commit "$commit_sha"
    done < <(git rev-list --reverse $range)

    echo "🔐 Scanning pushed commit history for secrets..."
    if ! ./scripts/secret_scan.sh --range "$range"; then
        echo ""
        echo "❌ Pre-push secret history scan failed!"
        echo "Fix the secret in the pushed commit range before pushing."
        exit 1
    fi
done

if [[ "$had_refs" != true ]]; then
    current_sha="$(git rev-parse HEAD)"
    ./scripts/agent_gate.sh --commit "$current_sha"
    echo "🔐 Scanning local-only commit history for secrets..."
    if ! ./scripts/secret_scan.sh --range "${current_sha} --not --remotes"; then
        echo ""
        echo "❌ Pre-push secret history scan failed!"
        echo "Fix the secret in the local-only commit range before pushing."
        exit 1
    fi
fi

# Activate virtual environment if it exists
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

# Run deployment checks
if ! python scripts/pre_deploy_check.py; then
    echo ""
    echo "❌ Pre-push checks failed!"
    echo "Fix the issues above before pushing."
    exit 1
fi

echo ""
echo "✅ All pre-push checks passed!"
exit 0
