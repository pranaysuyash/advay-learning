VITE_API_BASE_URL=http://localhost:8000
VITE_API_VERSION=v1
VITE_WS_URL=ws://localhost:8000
VITE_ENABLE_MOCK_DATA=false
VITE_VISION_WORKER_ENABLED=true
VITE_VISION_WORKER_FORCE_MAIN_THREAD=false
VITE_IMAGE_OPTIMIZATION_ENABLED=true
VITE_FEATURE_LETTER_TRACING_EVENTS=true
VITE_BETA_FREE_ACCESS=true
VITE_BETA_LABEL=Public beta
VITE_BETA_END_DATE=March 31, 2026
# Enable local AI runtime (Kokoro TTS, Transformers.js) and required model downloads.
# This can be disabled for lightweight builds by setting it to `false`.
VITE_BETA_LOCAL_AI_ENABLED=true

# Enable experimental 3D game support.
# Set to `false` to omit 3D game routes from the build.
VITE_BETA_3D_GAMES_ENABLED=true
VITE_SUPPORT_EMAIL=support@advay.app

# =============================================================================
# AI LLM CONFIGURATION
# =============================================================================

# Enable AI LLM responses (requires VITE_BETA_LOCAL_AI_ENABLED=true)
# VITE_AI_LLM_ENABLED=true

# LLM Provider: 'transformers-js' | 'web-llm' | 'ollama' | 'hf-inference' | 'lm-studio' | 'mock'
# - transformers-js: Run models in browser with Transformers.js
# - web-llm: Run models with WebLLM (GPU accelerated)
# - ollama: Connect to local Ollama server (http://localhost:11434)
# - hf-inference: Use Hugging Face Inference API (cloud)
# - lm-studio: Connect to LM Studio local server (http://localhost:1234)
# - mock: Use deterministic mock responses (default, no AI)
VITE_AI_LLM_PROVIDER=mock

# Model selection (provider-dependent)
# Options: 'qwen3.5-1.5b-instruct' | 'qwen3.5-0.5b-instruct' | 'qwen3.5-3b-instruct' | 'smollm3-3b-instruct' | 'qwen3.5-7b-instruct' | 'qwen3-8b-instruct'
VITE_AI_LLM_MODEL=qwen3.5-1.5b-instruct
VITE_AI_LLM_FALLBACK_MODEL=qwen3.5-0.5b-instruct

# LM Studio configuration (only used when VITE_AI_LLM_PROVIDER=lm-studio)
# LM Studio runs an OpenAI-compatible API at http://localhost:1234/v1 by default
# VITE_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Ollama configuration (only used when VITE_AI_LLM_PROVIDER=ollama)
# VITE_OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face configuration (only used when VITE_AI_LLM_PROVIDER=hf-inference)
# VITE_HF_API_KEY=your_huggingface_api_key

# AI safety settings
VITE_AI_MAX_RESPONSE_LENGTH=220
VITE_AI_CLOUD_FALLBACK_ENABLED=false
VITE_AI_PARENT_CONSENT=false
